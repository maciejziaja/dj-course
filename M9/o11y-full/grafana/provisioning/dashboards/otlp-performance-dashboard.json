    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Rozkład czasów trwania requestów obsługiwanych przez serwis (server-side), na bazie histogramu `http_server_duration_milliseconds`. Filtrowany przez `$route` i `$method`.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }, { "color": "red", "value": 80 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
      "id": 101,
      "options": {
        "calculate": true,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" },
        "yAxis": { "axisLabel": "Count" }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "sum(rate(http_server_duration_milliseconds_bucket{http_route=~\"$route\", http_method=~\"$method\"}[$__rate_interval])) by (le)",
          "format": "time_series",
          "legendFormat": "{{le}} ms",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "http_server_duration_milliseconds — Histogram",
      "type": "histogram"
    },
