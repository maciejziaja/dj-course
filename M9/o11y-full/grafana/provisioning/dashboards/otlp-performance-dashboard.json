          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "topk($topk_n,\n  histogram_quantile($quantile,\n    sum by (http_method, http_route, le) (\n      rate(http_server_duration_milliseconds_bucket{http_route=~\"$route\", http_method=~\"$method\"}[$__rate_interval])\n    )\n  ) > 0\n)",
