        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"} |= \"$search\" | severity_text=\"error\" [$__auto]))",
